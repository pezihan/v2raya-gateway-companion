# ==============================================================================
# v2rayA 网关智能分流伴侣 - 环境变量配置示例 (.env.example)
# 使用方式: 复制本文件为 .env 并根据需要修改: cp .env.example .env
# ==============================================================================

# Web 管理界面及 API 访问密码 (留空则开启内网免密直访模式)
AUTH_PASSWORD=

# v2rayA 管理员账号 (留空时将自动从 /etc/v2raya/bolt.db 中自动解析)
V2RAYA_USER=

# v2rayA 服务通信地址
V2RAYA_URL=http://127.0.0.1:2017

# v2rayA 配置存储数据库路径
V2RAYA_DB_PATH=/etc/v2raya/v2raya.db

# 规则自动同步检测间隔 (秒)
SYNC_INTERVAL=60

# 国内快速 DNS 探针服务器
DOMESTIC_DNS=223.5.5.5

# 海外真实 DoH DNS 服务器 (用于测墙比对)
OVERSEAS_DOH=https://1.1.1.1/dns-query
